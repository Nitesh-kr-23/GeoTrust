# Requires "Places API (New)" enabled in Google Cloud Console — NOT the
# legacy "Places API".
GOOGLE_PLACES_API_KEY=your_key_here

# Leave as-is for local dev (SQLite, zero setup).
# For a "production-style" demo, swap for Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://geotrust:geotrust@localhost:5432/geotrust
DATABASE_URL=sqlite:///./geotrust.db

DEFAULT_SEARCH_RADIUS_M=4000
MAX_RESULTS_RETURNED=3

# "development" (default) allows permissive CORS and auto-creates DB tables.
# Set to "production" on any real deployment 
ENVIRONMENT=development

# Comma-separated frontend origins allowed to call this API. Only enforced
# when ENVIRONMENT=production. Example:
# CORS_ALLOWED_ORIGINS=https://geotrust-frontend.onrender.com
CORS_ALLOWED_ORIGINS=

# Requests per minute, per client IP, on the search endpoint.
RATE_LIMIT_PER_MINUTE=30
